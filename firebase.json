{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "infra/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "app/static",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "workout-agent",
          "region": "europe-west1"
        }
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Workout Agent",
        "supportEmail": "th.vrancken@gmail.com"
      }
    }
  }
}
